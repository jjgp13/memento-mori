# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API.
# Both values are public by design; never put the service-role / secret key or DB password here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
